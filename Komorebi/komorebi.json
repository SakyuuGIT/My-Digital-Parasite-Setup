{
  "$schema": "https://raw.githubusercontent.com/LGUG2Z/komorebi/v0.1.42/schema.json",
  "app_specific_configuration_path": "$Env:USERPROFILE/applications.json",
  "window_hiding_behaviour": "Cloak",
  "cross_monitor_move_behaviour": "Insert",

  "transparency": false,
  "transparency_alpha": 252,
  "default_workspace_padding": 8,
  "default_container_padding": 8,
  "border": false,
  "border_style":"Rounded",
  "border_width": 4,
  "border_offset": -1,
  "mouse_follows_focus": false,
  "animation": {
    "enabled": false,
    "duration": 320,
    "fps": 320,
    "style": {
        "movement":"EaseInOutQuad",
        "transparency": "Linear"
      }
},
  "border_colours": {
    "single": "#ff2d7a",
    "unfocused": "#6b6880",
    "floating": "#ff2d7a",
    "monocle": "#6b6880"
  },
  "monitors": [
    // monitor 1, index 0
    {
      "workspaces": [
        {
          "name": "I",
          "layout": "BSP"
        },
        {
          "name": "II",
          "layout": "BSP"
        },
        {
          "name": "III",
          "layout": "BSP"
        }
      ]
    },
    // monitor 2, index 1
    {
      "workspaces": [
        {
          "name": "Home",
          "layout": "Rows"
        },
        {
          "name": "2",
          "layout": "Rows"
        },
        {
          "name": "3",
          "layout": "Rows"
        },
	
      ]
    }
  ],
 "ignore_rules": [
    {
"kind": "Exe",
"id": "ACShadows.exe",
"matching_strategy": "Equals",
},
{
"kind": "Exe",
"id": "Overwatch.exe",
"matching_strategy": "Equals",
},
{
"kind": "Exe",
"id": "Photos.exe",
"matching_strategy": "Equals",
},
{
"kind": "Exe",
"id": "PotPlayerMini64.exe",
"matching_strategy": "Equals",
},
{
"kind": "Exe",
"id": "Elgato.WaveLink.exe",
"matching_strategy": "Equals",
},
{
"kind": "Exe",
"id": "celestial.exe",
"matching_strategy": "Equals",
},
{
"kind": "Exe",
"id": "framepacer.exe",
"matching_strategy": "Equals",
},
{
"kind": "Title",
"id": "Picture in picture",
"matching_strategy": "Equals",
},
{
"kind": "Exe",
"id": "deadlock.exe",
"matching_strategy": "Equals",
},
{
"kind": "Exe",
"id": "Handy.exe",
"matching_strategy": "Equals",
},
]
}