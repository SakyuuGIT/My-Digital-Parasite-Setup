theme
{
	name = "modern"

	view = view.small

	background
	{
		color = #0a0a12
		opacity = 100
		// effect = 2
	}

	item
	{
		opacity = 100
		radius = 14
		prefix = 1

		text
		{
			normal = #e8e6f0
			select = #e8e6f0
			normal-disabled = #a8a6bc
			select-disabled = #a8a6bc
		}

		back
		{
			select = #12121f
			select-disabled = #12121f
		}
	}

	// font
	// {
	// 	size = 14
	// 	name = "Segoe UI Variable Text"
	// 	weight = 2
	// 	italic = 0
	// }

	border
	{
		enabled = true
		size = 1
		color = #12121f
		opacity = 100
		radius = 16
	}

	shadow
	{
		enabled = true
		size = 5
		opacity = 5
		color = #0d0d18
	}

	separator
	{
		size = 1
		color = #12121f
	}

	symbol
	{
		normal = #00e5ff
		select = #00e5ff
		normal-disabled = #a8a6bc
		select-disabled = #a8a6bc
	}

	image
	{
		enabled = true
		color = [#e8e6f0, #00e5ff, #0a0a12]
	}
}
